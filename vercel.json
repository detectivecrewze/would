{
  "redirects": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "gift", "value": "(?<giftId>[a-z0-9][a-z0-9-]{2,63})" }
      ],
      "missing": [
        { "type": "query", "key": "fromShare" }
      ],
      "destination": "/share/:giftId",
      "permanent": false,
      "preserveQueryParams": false
    }
  ],
  "rewrites": [
    {
      "source": "/share/:id",
      "destination": "/api/share/:id"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/studio/",
      "destination": "/studio.html"
    }
  ]
}
